{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "noddle",
	"compatibility_date": "2026-11-07",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [{ "pattern": "noddle.sampacker.com", "custom_domain": true }],
	"workers_dev": true,
	"preview_urls": true
}
