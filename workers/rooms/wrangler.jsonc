{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "noddle-rooms",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-07",
	"routes": [{ "pattern": "noddle-rooms.sampacker.com", "custom_domain": true }],
	"rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": false }],
	"durable_objects": {
		"bindings": [{ "name": "ROOMS", "class_name": "RoomObject" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "noddle",
			"database_id": "06b9b8d9-a0f7-489d-9e5b-6531fd92f72c",
			"migrations_dir": "../../drizzle"
		}
	],
	"observability": { "enabled": true }
}
