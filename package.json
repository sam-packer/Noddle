{
	"name": "triangle-ai-hackathon",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:rooms": "wrangler d1 migrations apply noddle --local --config workers/rooms/wrangler.jsonc && wrangler dev --config workers/rooms/wrangler.jsonc --port 8787",
		"dev:all": "trap 'kill 0' EXIT; bun run dev:rooms & vite dev",
		"rooms:check": "bun scripts/rooms-check.ts",
		"deploy": "bun run deploy:rooms && bun run deploy:app",
		"deploy:rooms": "wrangler d1 migrations apply noddle --remote --config workers/rooms/wrangler.jsonc && env -u WRANGLER_CI_OVERRIDE_NAME -u WRANGLER_CI_MATCH_TAG wrangler deploy --config workers/rooms/wrangler.jsonc",
		"deploy:app": "PUBLIC_ROOMS_URL=https://noddle-rooms.sampacker.com bun run build && wrangler deploy",
		"build": "wrangler types --check --env-file .env.example && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check --env-file .env.example && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types --env-file .env.example",
		"report": "bun scripts/report.ts",
		"replay": "bun scripts/replay.ts",
		"pointer": "bun scripts/pointer.ts",
		"benchmark": "bun scripts/benchmark.ts",
		"accuracy": "bun scripts/accuracy.ts",
		"tune": "bun scripts/tune.ts",
		"gate": "bun scripts/gate.ts",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@tensorflow/tfjs": "^4.22.0",
		"@types/bun": "^1.4.4",
		"@types/node": "^26",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"ml-matrix": "^6.15.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"@mediapipe/tasks-vision": "^1.2.2",
		"onnxruntime-web": "^1.31.1"
	}
}
